{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store-analytics.local/schemas/weekly-interpretation-content-v1.schema.json",
  "title": "WeeklyInterpretationContent v1",
  "description": "Strict LLM-generated weekly interpretation content. Backend-owned envelope metadata is outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "store",
    "teamInsights",
    "employees",
    "dataLimitations"
  ],
  "properties": {
    "store": {
      "$ref": "#/$defs/storeInterpretation"
    },
    "teamInsights": {
      "$ref": "#/$defs/teamInterpretation"
    },
    "employees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/employeeInterpretation"
      },
      "maxItems": 10
    },
    "dataLimitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataLimitation"
      },
      "maxItems": 20
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Z][A-Z0-9:._-]+$"
    },
    "employeeRef": {
      "type": "string",
      "pattern": "^E[0-9]{2,4}$"
    },
    "narrativeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "headlineBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "nullableNarrativeBlock": {
      "anyOf": [
        {
          "$ref": "#/$defs/narrativeBlock"
        },
        {
          "type": "null"
        }
      ]
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "theme",
        "candidateRef",
        "title",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OBSERVATION",
            "SYNTHESIS",
            "HYPOTHESIS",
            "RISK",
            "OPPORTUNITY"
          ]
        },
        "theme": {
          "enum": [
            "FINANCIAL_RESULT",
            "REVENUE_DYNAMICS",
            "PROFITABILITY",
            "PLAN",
            "CATEGORY_MIX",
            "ADDITIONAL_SALES",
            "ATTACH_RATE",
            "RETURNS",
            "TIME_EFFICIENCY",
            "TEAM_PERFORMANCE",
            "EMPLOYEE_PERFORMANCE",
            "SALES_QUALITY",
            "DATA_QUALITY",
            "OTHER"
          ]
        },
        "candidateRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[A-Z][A-Z0-9:._-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "nullableInsight": {
      "anyOf": [
        {
          "$ref": "#/$defs/insight"
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "summary",
        "evidenceRefs",
        "targetScope",
        "targetEmployeeRefs",
        "horizon"
      ],
      "properties": {
        "type": {
          "enum": [
            "COACHING",
            "PEER_LEARNING",
            "PROCESS_REVIEW",
            "CATEGORY_FOCUS",
            "MONITORING",
            "INVESTIGATION"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "targetScope": {
          "enum": [
            "STORE",
            "TEAM",
            "EMPLOYEE"
          ]
        },
        "targetEmployeeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/employeeRef"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "horizon": {
          "enum": [
            "CURRENT_WEEK",
            "NEXT_WEEK",
            "MONTH_END",
            "MONITORING_PERIOD"
          ]
        }
      }
    },
    "dataLimitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "scope",
        "employeeRef",
        "categoryCode",
        "impact",
        "affectedSections",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "scope": {
          "enum": [
            "STORE",
            "TEAM",
            "EMPLOYEE",
            "CATEGORY",
            "METRIC"
          ]
        },
        "employeeRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/employeeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "categoryCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "pattern": "^[A-Z][A-Z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "impact": {
          "enum": [
            "REDUCED_CONFIDENCE",
            "UNAVAILABLE"
          ]
        },
        "affectedSections": {
          "type": "array",
          "items": {
            "enum": [
              "RESULT",
              "DYNAMICS",
              "PLAN",
              "PROFITABILITY",
              "CATEGORY_PERFORMANCE",
              "ADDITIONAL_SALES",
              "TIME_EFFICIENCY",
              "RATING",
              "TEAM_COMPARISON",
              "RECOMMENDATIONS"
            ]
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "categoryInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "growthDrivers",
        "declineDrivers",
        "mixInsights"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "growthDrivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "declineDrivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "mixInsights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        }
      }
    },
    "additionalSalesInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "revenueInsights",
        "attachRateInsights",
        "opportunities"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "revenueInsights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "attachRateInsights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 2
        }
      }
    },
    "storeInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "resultSummary",
        "dynamicsSummary",
        "categoryPerformance",
        "additionalSalesPerformance",
        "planOutlook",
        "strength",
        "attentionArea",
        "primaryRisk",
        "recommendedActions"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/headlineBlock"
        },
        "resultSummary": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "dynamicsSummary": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "categoryPerformance": {
          "$ref": "#/$defs/categoryInterpretation"
        },
        "additionalSalesPerformance": {
          "$ref": "#/$defs/additionalSalesInterpretation"
        },
        "planOutlook": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "strength": {
          "$ref": "#/$defs/nullableInsight"
        },
        "attentionArea": {
          "$ref": "#/$defs/nullableInsight"
        },
        "primaryRisk": {
          "$ref": "#/$defs/nullableInsight"
        },
        "recommendedActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendedAction"
          },
          "maxItems": 3
        }
      }
    },
    "competencyCode": {
      "anyOf": [
        {
          "enum": [
            "COMMERCIAL_CONTRIBUTION",
            "TIME_EFFICIENCY",
            "ACCESSORY_SALES",
            "SERVICE_SALES",
            "ADDITIONAL_SALES",
            "ATTACH_RATE"
          ]
        },
        {
          "type": "string",
          "pattern": "^CATEGORY:[A-Z][A-Z0-9_]+$",
          "maxLength": 110
        }
      ]
    },
    "competencyLeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyCode",
        "employeeRefs",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "competencyCode": {
          "$ref": "#/$defs/competencyCode"
        },
        "employeeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/employeeRef"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "employeeHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "employeeRef",
        "kind",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "employeeRef": {
          "$ref": "#/$defs/employeeRef"
        },
        "kind": {
          "enum": [
            "OBSERVATION",
            "SYNTHESIS",
            "OPPORTUNITY"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "learningOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyCode",
        "mentorEmployeeRefs",
        "targetEmployeeRefs",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "competencyCode": {
          "$ref": "#/$defs/competencyCode"
        },
        "mentorEmployeeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/employeeRef"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "targetEmployeeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/employeeRef"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "teamInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "highlights",
        "competencyLeaders",
        "mostImproved",
        "learningOpportunities"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 4
        },
        "competencyLeaders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/competencyLeader"
          },
          "maxItems": 12
        },
        "mostImproved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/employeeHighlight"
          },
          "maxItems": 2
        },
        "learningOpportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/learningOpportunity"
          },
          "maxItems": 6
        }
      }
    },
    "employeeCategoryInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "strengths",
        "attentionAreas",
        "dynamics"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/nullableNarrativeBlock"
        },
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "attentionAreas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "dynamics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        }
      }
    },
    "employeeAdditionalSalesInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "revenueInsights",
        "attachRateInsights",
        "opportunities"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "revenueInsights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 2
        },
        "attachRateInsights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 3
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/insight"
          },
          "maxItems": 2
        }
      }
    },
    "nullableEmployeeAdditionalSalesInterpretation": {
      "anyOf": [
        {
          "$ref": "#/$defs/employeeAdditionalSalesInterpretation"
        },
        {
          "type": "null"
        }
      ]
    },
    "employeeInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "employeeRef",
        "analysisStatus",
        "headline",
        "workloadContext",
        "performanceSummary",
        "dynamicsSummary",
        "categoryPerformance",
        "additionalSalesPerformance",
        "strength",
        "attentionArea",
        "primaryRisk",
        "recommendedActions",
        "dataLimitations"
      ],
      "properties": {
        "employeeRef": {
          "$ref": "#/$defs/employeeRef"
        },
        "analysisStatus": {
          "enum": [
            "SUFFICIENT",
            "LIMITED",
            "INSUFFICIENT"
          ]
        },
        "headline": {
          "$ref": "#/$defs/headlineBlock"
        },
        "workloadContext": {
          "$ref": "#/$defs/narrativeBlock"
        },
        "performanceSummary": {
          "$ref": "#/$defs/nullableNarrativeBlock"
        },
        "dynamicsSummary": {
          "$ref": "#/$defs/nullableNarrativeBlock"
        },
        "categoryPerformance": {
          "$ref": "#/$defs/employeeCategoryInterpretation"
        },
        "additionalSalesPerformance": {
          "$ref": "#/$defs/nullableEmployeeAdditionalSalesInterpretation"
        },
        "strength": {
          "$ref": "#/$defs/nullableInsight"
        },
        "attentionArea": {
          "$ref": "#/$defs/nullableInsight"
        },
        "primaryRisk": {
          "$ref": "#/$defs/nullableInsight"
        },
        "recommendedActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendedAction"
          },
          "maxItems": 2
        },
        "dataLimitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataLimitation"
          },
          "maxItems": 5
        }
      }
    }
  }
}
