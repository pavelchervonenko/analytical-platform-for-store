APP_ENV=dev

POSTGRES_DB=store_analytics
POSTGRES_USER=store_analytics
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/store_analytics
SPRING_DATASOURCE_USERNAME=store_analytics
SPRING_DATASOURCE_PASSWORD=change_me

# One-shot Flyway migration safety budgets.
MIGRATION_LOCK_TIMEOUT=5s
MIGRATION_STATEMENT_TIMEOUT=10m
MIGRATION_LOCK_RETRY_COUNT=10

# Backend resource budgets. Split production worker uses DB_POOL_MAX_SIZE=5 and
# DB_POOL_MIN_IDLE=1; API defaults are 10 and 2.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_VALIDATION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_KEEPALIVE_TIME_MS=120000
DB_POOL_INITIALIZATION_FAIL_TIMEOUT_MS=1

HTTP_MAX_REQUEST_HEADER_SIZE=8KB
HTTP_MAX_REQUEST_BODY_SIZE=2MB
HTTP_MAX_FORM_POST_SIZE=2MB
HTTP_MAX_SWALLOW_SIZE=2MB
HTTP_CONNECTION_TIMEOUT=10s
HTTP_KEEP_ALIVE_TIMEOUT=20s
HTTP_MAX_CONNECTIONS=512
HTTP_ACCEPT_COUNT=100
HTTP_MAX_THREADS=64
HTTP_MIN_SPARE_THREADS=8
HTTP_MAX_QUEUE_CAPACITY=128
HTTP_MAX_KEEP_ALIVE_REQUESTS=100
HTTP_MAX_PARAMETER_COUNT=256

LIVESKLAD_BASE_URL=https://api.livesklad.com
LIVESKLAD_LOGIN=put_api_login_here
LIVESKLAD_PASSWORD=put_api_password_here
LIVESKLAD_CONNECT_TIMEOUT=5s
LIVESKLAD_READ_TIMEOUT=30s

# LLM/notification rollout is fail-closed. Enable stages separately only after
# contracts, credentials, database migrations and worker monitoring are ready.
INTERPRETATION_SNAPSHOT_ENABLED=false
INTERPRETATION_AVAILABILITY_PREPARATION_SLA=5m
INTERPRETATION_AVAILABILITY_REFRESH_INTERVAL=15s
INTERPRETATION_AVAILABILITY_TARGET_READY_TIME=08:00
INTERPRETATION_SNAPSHOT_WORKER_ENABLED=false
INTERPRETATION_SNAPSHOT_WORKER_DELAY=5s
INTERPRETATION_SNAPSHOT_LEASE_DURATION=10m
INTERPRETATION_SNAPSHOT_HEARTBEAT_INTERVAL=1m
INTERPRETATION_SNAPSHOT_RETRY_INITIAL_DELAY=30s
INTERPRETATION_SNAPSHOT_RETRY_MAX_DELAY=15m
INTERPRETATION_SNAPSHOT_PLANNER_ENABLED=false
INTERPRETATION_SNAPSHOT_PLANNER_SCAN_DELAY=1m
INTERPRETATION_SNAPSHOT_REVISION_WINDOW=72h
INTERPRETATION_SNAPSHOT_PLANNER_BATCH_SIZE=25
INTERPRETATION_SNAPSHOT_JOB_MAX_ATTEMPTS=5
INTERPRETATION_GENERATION_ENABLED=false
INTERPRETATION_GENERATION_PLANNER_ENABLED=false
INTERPRETATION_GENERATION_PLANNER_SCAN_DELAY=1m
INTERPRETATION_GENERATION_PLANNER_BATCH_SIZE=25
INTERPRETATION_GENERATION_JOB_DEADLINE=5m
INTERPRETATION_GENERATION_WORKER_ENABLED=false
INTERPRETATION_GENERATION_WORKER_DELAY=5s
INTERPRETATION_GENERATION_LEASE_DURATION=4m
INTERPRETATION_GENERATION_HEARTBEAT_INTERVAL=15s
INTERPRETATION_GENERATION_RECOVERY_DELAY=30s
INTERPRETATION_GENERATION_PROVIDER_CALL_TIMEOUT=180s
INTERPRETATION_GENERATION_MAX_REQUEST_BYTES=524288
INTERPRETATION_GENERATION_MAX_ESTIMATED_COST_RUB=50.00
INTERPRETATION_PUBLICATION_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_FANOUT_ENABLED=false
TELEGRAM_BOT_CODE=store-analytics-primary
TELEGRAM_FANOUT_DELAY=5s
TELEGRAM_DELIVERY_MAX_ATTEMPTS=5
TELEGRAM_WEEKLY_RENDER_VERSION=weekly-telegram-v1
TELEGRAM_LINKING_ENABLED=false
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TOKEN_TTL=10m
TELEGRAM_PENDING_CONFIRMATION_TTL=10m
TELEGRAM_LINK_ISSUE_MIN_INTERVAL=30s
TELEGRAM_LINK_MAX_PER_HOUR=5
# Required only when webhook is enabled; 16-256 chars from A-Z, a-z, 0-9, _ and -.
# Production Compose mounts this host file through Docker secrets.
TELEGRAM_WEBHOOK_SECRET_FILE=
# Direct values are supported only for explicitly controlled local processes.
TELEGRAM_WEBHOOK_SECRET=
# Temporary grace secret used only during a controlled webhook-secret rotation.
TELEGRAM_WEBHOOK_PREVIOUS_SECRET=
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=65536
TELEGRAM_DELIVERY_ENABLED=false
# Secret issued by BotFather; never commit a real value.
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_CONNECT_TIMEOUT=5s
TELEGRAM_READ_TIMEOUT=15s
TELEGRAM_DELIVERY_DELAY=5s
TELEGRAM_DELIVERY_LEASE_DURATION=1m
TELEGRAM_DELIVERY_RETRY_INITIAL_DELAY=15s
TELEGRAM_DELIVERY_RETRY_MAX_DELAY=5m
TELEGRAM_MAX_RESPONSE_BYTES=65536
DAILY_STORE_PULSE_ENABLED=false
DAILY_STORE_PULSE_PLANNER_DELAY=5m
DAILY_STORE_PULSE_SEND_AFTER=08:05
DAILY_STORE_PULSE_EXPIRES_AT=14:00
DAILY_STORE_PULSE_POLICY_VERSION=daily-store-pulse-v1
DAILY_STORE_PULSE_RENDER_VERSION=daily-store-pulse-v2

# Versioned, non-secret generation settings.
LLM_PROMPT_VERSION=weekly-interpretation-v4
LLM_CONTENT_SCHEMA_VERSION=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_PROVIDER_CALLS=2

# Yandex Cloud Foundation Models. Keep real credentials outside Git.
YANDEX_AI_FOLDER_ID=
# Production Compose reads the API key from this file as a Docker secret.
YANDEX_AI_API_KEY_FILE=
# Direct value is supported only for an explicitly controlled local process.
YANDEX_AI_API_KEY=
# Prefer an explicit version, for example gpt://<folder-id>/yandexgpt-5.1.
YANDEX_AI_MODEL_URI=
YANDEX_AI_CONNECT_TIMEOUT=5s
YANDEX_AI_READ_TIMEOUT=180s
# Review model limits and prices against current official documentation before rollout.
YANDEX_AI_CONTEXT_WINDOW_TOKENS=32768
YANDEX_AI_MAX_RESPONSE_BYTES=1048576
YANDEX_AI_INPUT_RUB_PER_THOUSAND_TOKENS=0.8
YANDEX_AI_CACHED_INPUT_RUB_PER_THOUSAND_TOKENS=0.8
YANDEX_AI_OUTPUT_RUB_PER_THOUSAND_TOKENS=0.8

SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Required: generate a unique random 32-256 character secret; never commit the real value.
# Production Compose mounts this host file through Docker secrets.
SECURITY_TELEMETRY_PSEUDONYM_KEY_FILE=
# Direct value is for an explicitly controlled local process only.
SECURITY_TELEMETRY_PSEUDONYM_KEY=
SECURITY_TELEMETRY_PSEUDONYM_KEY_ID=dev-v1
LOG_STRUCTURED_FORMAT=ecs
# Comma-separated non-secret UUIDs of customer-owned emergency accounts.
BREAK_GLASS_USER_IDS=

# Successful high-risk command responses are retained briefly for safe timeout retries.
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000
IDEMPOTENCY_CLEANUP_CRON=0 15 4 * * *

# Retention runs in dry-run mode until deletion is explicitly enabled.
RETENTION_SCHEDULING_ENABLED=true
RETENTION_DELETION_ENABLED=false
# Required evidence references before RETENTION_DELETION_ENABLED may be true.
RETENTION_POLICY_APPROVAL_REFERENCE=UNAPPROVED
RETENTION_BACKUP_CHECKPOINT_REFERENCE=UNVERIFIED
RETENTION_RESTORE_TESTED_AT=1970-01-01T00:00:00Z
RETENTION_MAXIMUM_RESTORE_TEST_AGE=90d
