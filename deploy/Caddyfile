{
	admin off
	email {$ACME_EMAIL}
	grace_period 30s

	servers {
		protocols h1 h2
		timeouts {
			read_body 30s
			read_header 10s
			write 5m
			idle 2m
		}
	}
}

{$APP_DOMAIN} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
	}

	request_body {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy backend-api:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 190s
			}
		}
	}

	handle /readyz {
		reverse_proxy backend-api:8080
	}

	handle /livez {
		reverse_proxy backend-api:8080
	}

	handle /actuator/* {
		respond 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
