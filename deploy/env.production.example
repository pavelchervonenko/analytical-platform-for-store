# Non-secret production configuration only. Real secrets are mounted as files.
COMPOSE_PROJECT_NAME=store-analytics
APP_DOMAIN=store-analytics.net
ACME_EMAIL=replace-with-customer-operations-email

# CI writes immutable image references with sha256 digests into the release env.
BACKEND_IMAGE=ghcr.io/pavelchervonenko/store-analytics-backend@sha256:replace
WEB_IMAGE=ghcr.io/pavelchervonenko/store-analytics-web@sha256:replace
RELEASE_ID=replace-with-release-id
BACKEND_IMAGE_DIGEST=sha256:replace
# Emergency/initial air-gap delivery only. Normal releases must pull by digest.
SKIP_IMAGE_PULL=false

DB_CERT_HOST=managed-631415-8744455
DB_HOST_ADDRESS=10.20.0.20
DB_PORT=5432
DB_NAME=store_analytics
DB_RUNTIME_USER=store_runtime
DB_MIGRATOR_USER=store_migrator

SPRING_PROFILES_ACTIVE=prod
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://store-analytics.net
TRUSTED_PROXY_CIDRS=172.30.10.0/24
MANAGEMENT_SERVER_PORT=9090

DB_POOL_MAX_SIZE_API=10
DB_POOL_MIN_IDLE_API=2
DB_POOL_MAX_SIZE_WORKER=5
DB_POOL_MIN_IDLE_WORKER=1

LIVESKLAD_BASE_URL=https://api.livesklad.com
LIVESKLAD_ALLOWED_HOSTS=api.livesklad.com
LIVESKLAD_CONNECT_TIMEOUT=5s
LIVESKLAD_READ_TIMEOUT=30s

SYNC_WORKER_ENABLED=true
SYNC_SCHEDULE_ENABLED=false
SYNC_SCHEDULE_CRON=0 15 3-8 * * *
SYNC_WINDOW_SIZE=6h
SYNC_SCHEDULE_ZONE=Europe/Kaliningrad
SYNC_INCREMENTAL_OVERLAP_DAYS=3
SYNC_MAXIMUM_BACKFILL_DAYS=730
PRODUCT_CLASSIFICATION_RECONCILIATION_ENABLED=false
PRODUCT_CLASSIFICATION_RECONCILIATION_PRODUCT_IDS=
PRODUCT_CLASSIFICATION_RECONCILIATION_EXPECTED_ITEMS=0

# Enable in this order after server-side acceptance: snapshot, generation,
# publication, linking/webhook, delivery, fanout, daily pulse.
INTERPRETATION_SNAPSHOT_ENABLED=false
INTERPRETATION_SNAPSHOT_WORKER_ENABLED=false
INTERPRETATION_SNAPSHOT_PLANNER_ENABLED=false
INTERPRETATION_GENERATION_ENABLED=false
INTERPRETATION_GENERATION_PLANNER_ENABLED=false
INTERPRETATION_GENERATION_WORKER_ENABLED=false
INTERPRETATION_PUBLICATION_ENABLED=false
INTERPRETATION_GENERATION_MAX_ESTIMATED_COST_RUB=30.00
LLM_PROMPT_VERSION=weekly-interpretation-v4
LLM_CONTENT_SCHEMA_VERSION=2
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_PROVIDER_CALLS=2
YANDEX_AI_FOLDER_ID=replace-with-folder-id
YANDEX_AI_MODEL_URI=gpt://replace-with-folder-id/yandexgpt-5.1
YANDEX_AI_CONNECT_TIMEOUT=5s
YANDEX_AI_READ_TIMEOUT=180s

TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_LINKING_ENABLED=false
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_FANOUT_ENABLED=false
TELEGRAM_BOT_CODE=store-analytics-primary
TELEGRAM_BOT_USERNAME=store_analytics_notify_bot
DAILY_STORE_PULSE_ENABLED=false

REPORTS_ANNUAL_SCHEDULING_ENABLED=true
REPORT_BACKFILL_WORKER_ENABLED=true

# Data deletion remains fail-closed until backup and restore evidence exists.
RETENTION_SCHEDULING_ENABLED=true
RETENTION_DELETION_ENABLED=false
RETENTION_POLICY_APPROVAL_REFERENCE=UNAPPROVED
RETENTION_BACKUP_CHECKPOINT_REFERENCE=UNVERIFIED
RETENTION_RESTORE_TESTED_AT=1970-01-01T00:00:00Z

SECURITY_TELEMETRY_PSEUDONYM_KEY_ID=prod-v1
BREAK_GLASS_USER_IDS=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

LOG_STRUCTURED_FORMAT=ecs
HTTP_MAX_REQUEST_BODY_SIZE=2MB
MIGRATION_LOCK_TIMEOUT=5s
MIGRATION_STATEMENT_TIMEOUT=10m
MIGRATION_LOCK_RETRY_COUNT=10

# Host paths; files are root:root 0600 unless explicitly documented.
POSTGRES_RUNTIME_PASSWORD_FILE=/etc/store-analytics/secrets/postgres-runtime-password
POSTGRES_MIGRATOR_PASSWORD_FILE=/etc/store-analytics/secrets/postgres-migrator-password
LIVESKLAD_LOGIN_FILE=/etc/store-analytics/secrets/livesklad-login
LIVESKLAD_PASSWORD_FILE=/etc/store-analytics/secrets/livesklad-password
YANDEX_AI_API_KEY_FILE=/etc/store-analytics/secrets/yandex-ai-api-key
TELEGRAM_BOT_TOKEN_FILE=/etc/store-analytics/secrets/telegram-bot-token
TELEGRAM_WEBHOOK_SECRET_FILE=/etc/store-analytics/secrets/telegram-webhook-secret
SECURITY_TELEMETRY_PSEUDONYM_KEY_FILE=/etc/store-analytics/secrets/security-telemetry-pseudonym-key
PROMETHEUS_SCRAPE_TOKEN_FILE=/etc/store-analytics/secrets/prometheus-scrape-token
BOOTSTRAP_ADMIN_PASSWORD_FILE=/etc/store-analytics/secrets/bootstrap-admin-password
POSTGRES_CA_FILE=/etc/store-analytics/pki/postgresql-ca.crt
