{
  "format_version": 1,
  "policy_version": "catalog-lexicon-draft-v5",
  "mode": "SHADOW_ONLY",
  "description": "Observed catalog feature vocabulary, not effective product assignments. Rules collect evidence; resolver composes context, never first-match category.",
  "normalization_aliases": [
    {
      "id": "mixed_case_word",
      "pattern": "чeхол",
      "replacement": "чехол"
    },
    {
      "id": "strap_typo",
      "pattern": "ремешоу",
      "replacement": "ремешок"
    },
    {
      "id": "mixed_camera_word",
      "pattern": "kaмер",
      "replacement": "камер"
    }
  ],
  "rules": [
    {
      "id": "iphone",
      "field": "family",
      "value": "IPHONE",
      "patterns": [
        "\\b(?:iphone|айфон)\\s*\\d*"
      ],
      "example": "iPhone 15 Pro"
    },
    {
      "id": "phone_alias",
      "field": "family",
      "value": "IPHONE",
      "patterns": [
        "^phone\\s*1[1-9](?:\\s|pro|plus|mini|e|\\d{2,3}gb)"
      ],
      "example": "Phone12 128GB Б/У",
      "review": "MODEL_ALIAS"
    },
    {
      "id": "samsung_phone",
      "field": "family",
      "value": "SAMSUNG_PHONE",
      "patterns": [
        "\\b(?:samsung|самсунг|galaxy|galxy)\\s*(?:galaxy\\s*|galxy\\s*)?(?:[asа]\\s*\\d{2}(?:fe)?|z\\s*(?:fold|flip)\\s*\\d)(?![a-zа-я0-9])"
      ],
      "example": "Samsung Galxy Z Fold 7"
    },
    {
      "id": "ipad",
      "field": "family",
      "value": "IPAD",
      "patterns": [
        "\\b(?:ipad|айпад)\\b"
      ],
      "example": "iPad Air"
    },
    {
      "id": "macbook",
      "field": "family",
      "value": "MACBOOK",
      "patterns": [
        "\\b(?:macbook|макбук)\\b"
      ],
      "example": "MacBook Air"
    },
    {
      "id": "other_tablet",
      "field": "family",
      "value": "OTHER_TABLET",
      "patterns": [
        "\\b(?:galaxy tab|xiaomi pad|redmi pad|планшет\\w*|tablet)\\b"
      ],
      "example": "Samsung Galaxy Tab S10",
      "exclude": [
        "\\b(?:ipad|айпад)\\b"
      ]
    },
    {
      "id": "other_laptop",
      "field": "family",
      "value": "OTHER_LAPTOP",
      "patterns": [
        "\\b(?:ноутбук|laptop|notebook|thinkpad|ideapad|vivobook|zenbook|matebook|magicbook|galaxy book)\\b"
      ],
      "example": "Lenovo ThinkPad",
      "exclude": [
        "\\b(?:macbook|макбук)\\b"
      ]
    },
    {
      "id": "apple_watch",
      "field": "family",
      "value": "APPLE_WATCH",
      "patterns": [
        "\\b(?:apple watch|iwatch)\\b"
      ],
      "example": "Apple Watch Ultra"
    },
    {
      "id": "samsung_watch",
      "field": "family",
      "value": "SAMSUNG_WATCH",
      "patterns": [
        "\\b(?:samsung|galaxy)\\s+watch\\b"
      ],
      "example": "Samsung Galaxy Watch 8"
    },
    {
      "id": "other_watch",
      "field": "family",
      "value": "OTHER_WATCH",
      "patterns": [
        "\\b(?:amazfit|huawei|honor|xiaomi)\\b.*\\b(?:watch|часы)\\b"
      ],
      "example": "Huawei Watch New"
    },
    {
      "id": "apple_headphones",
      "field": "family",
      "value": "APPLE_HEADPHONES",
      "patterns": [
        "\\b(?:airpods|earpods)\\b"
      ],
      "example": "Apple EarPods USB C"
    },
    {
      "id": "samsung_headphones",
      "field": "family",
      "value": "SAMSUNG_HEADPHONES",
      "patterns": [
        "\\b(?:galaxy\\s+buds|samsung\\s+buds|buds\\s*[34])"
      ],
      "example": "Galaxy Buds 3"
    },
    {
      "id": "other_headphones",
      "field": "family",
      "value": "OTHER_HEADPHONES",
      "patterns": [
        "\\b(?:marshall major|sony w[fh]\\s*1000\\w*|наушник\\w*|headphones?|earphones?|яндекс дропс)\\b"
      ],
      "example": "Marshall Major 5",
      "exclude": [
        "\\b(?:airpods|earpods|galaxy\\s+buds|samsung\\s+buds|buds\\s*[34])\\b"
      ]
    },
    {
      "id": "garmin_reviewed_watch",
      "field": "family",
      "value": "OTHER_WATCH",
      "patterns": [
        "\\bgarmin\\s+(?:forerunner\\s+165\\s+music|v[ií]voactive\\s+6)\\b"
      ],
      "example": "Garmin Forerunner 165 Music"
    },
    {
      "id": "fitness",
      "field": "family",
      "value": "FITNESS",
      "patterns": [
        "\\b(?:garmin|fitbit|whoop)\\b"
      ],
      "example": "Garmin Forerunner",
      "exclude": [
        "\\bgarmin\\s+(?:forerunner\\s+165\\s+music|v[ií]voactive\\s+6)\\b"
      ]
    },
    {
      "id": "speakers",
      "field": "family",
      "value": "SPEAKER",
      "patterns": [
        "\\b(?:колонк\\w*|яндекс станци\\w*|yandex station|jbl flip|jbl charge|harman kardon onyx|(?:bluetooth|wireless) speaker)\\b"
      ],
      "example": "Колонка JBL Flip"
    },
    {
      "id": "smart_glasses",
      "field": "family",
      "value": "SMART_GLASSES",
      "patterns": [
        "\\b(?:ray\\s*ban|rayban|meta wayfarer)\\b"
      ],
      "example": "Ray Ban Meta",
      "scope": "livesklad-default",
      "review": "STORE_SPECIFIC_RULE"
    },
    {
      "id": "instax",
      "field": "family",
      "value": "CAMERA",
      "patterns": [
        "\\b(?:instax|фотоаппарат)\\b"
      ],
      "example": "Instax Mini 13",
      "exclude": [
        "\\b(?:пленк\\w*|film|картридж)\\b"
      ]
    },
    {
      "id": "styler",
      "field": "family",
      "value": "HAIR_STYLER",
      "patterns": [
        "\\b(?:стайлер|dyson\\s+(?:hs\\d+|airwrap)|airwrap)\\b"
      ],
      "example": "Dyson HS08"
    },
    {
      "id": "microphone",
      "field": "family",
      "value": "MICROPHONE",
      "patterns": [
        "\\b(?:микрофон\\w*|dji mic|microphone)\\b"
      ],
      "example": "Микрофон DJI Mic 2 Charging Case",
      "exclude": [
        "^(?:чистк\\w*|ремонт|замена)\\b"
      ]
    },
    {
      "id": "console",
      "field": "family",
      "value": "CONSOLE",
      "patterns": [
        "\\b(?:play\\s*station\\s*5|sony\\s+ps\\s*5|ps5)\\b"
      ],
      "example": "Sony PlayStation 5 Slim",
      "exclude": [
        "\\b(?:dualsense|dual sense|disc\\s*drive|дисковод|док\\s*станц\\w*|charging\\s*station|chargingstation|геймпад|контроллер)\\b"
      ]
    },
    {
      "id": "gaming_accessory",
      "field": "item",
      "value": "GAMING_ACCESSORY",
      "patterns": [
        "\\b(?:dualsense|dual sense|disc\\s*drive|дисковод|геймпад|контроллер)\\b"
      ],
      "example": "Sony DualSense"
    },
    {
      "id": "case",
      "field": "item",
      "value": "CASE",
      "patterns": [
        "\\b(?:чехол|чехлол|чехлы|чехл\\w*|case|cover|бампер)\\b"
      ],
      "example": "Чехол iPhone",
      "exclude": [
        "\\b(?:dji mic|микрофон\\w*|microphone)\\b.*\\bcharging case\\b"
      ]
    },
    {
      "id": "keephone_case_line",
      "field": "item",
      "value": "CASE",
      "patterns": [
        "^(?:keephone\\s+x\\s*crystal|mago pro)\\b"
      ],
      "example": "Keephone X Crystal Samsung",
      "review": "MODEL_ALIAS"
    },
    {
      "id": "screen_glass",
      "field": "item",
      "value": "SCREEN_GLASS",
      "patterns": [
        "\\b(?:стекл\\w*|стекол)\\b"
      ],
      "example": "Защитное стекло",
      "exclude": [
        "\\b(?:камер\\w*|линз\\w*)\\b",
        "\\bcamera\\s+(?:film|lens)\\b"
      ]
    },
    {
      "id": "camera_glass",
      "field": "item",
      "value": "CAMERA_GLASS",
      "patterns": [
        "\\b(?:(?:защит\\w*|стекл\\w*)\\s+(?:на\\s+|для\\s+)?(?:камер\\w*|линз\\w*)|camera\\s+(?:film|lens)|линзы\\s+на\\s+камер\\w*)\\b"
      ],
      "example": "Защита камер Keephone iPhone"
    },
    {
      "id": "film",
      "field": "item",
      "value": "FILM",
      "patterns": [
        "\\b(?:пленк\\w*|film)\\b"
      ],
      "example": "Пленка гидрогелевая",
      "exclude": [
        "\\b(?:camera|instax)\\b"
      ]
    },
    {
      "id": "strap",
      "field": "item",
      "value": "STRAP",
      "patterns": [
        "\\b(?:ремеш\\w*|strap|band)\\b"
      ],
      "example": "Ремешок Watch",
      "exclude": [
        "^apple watch\\s+(?:ultra(?:\\s+\\d+)?|series\\s+\\d+|se(?:\\s+\\d+)?|\\d+)\\b.*\\b\\d{2}\\s*mm\\b.*\\bband\\b",
        "^(?:fitbit|whoop)\\b.*\\bwith\\b.*\\bband\\b",
        "^garmin\\s+v[ií]voactive\\s+6\\b.*\\bwith\\s+black\\s+band\\b"
      ]
    },
    {
      "id": "cardholder",
      "field": "item",
      "value": "CARDHOLDER",
      "patterns": [
        "\\b(?:кардхолдер|картхолдер|cardholder)\\b"
      ],
      "example": "Кардхолдер Baseus"
    },
    {
      "id": "tracker",
      "field": "item",
      "value": "TRACKER",
      "patterns": [
        "\\b(?:taggy|airtag)\\b"
      ],
      "example": "Taggy Keephone"
    },
    {
      "id": "stand",
      "field": "item",
      "value": "HOLDER",
      "patterns": [
        "\\b(?:монопод|трипод|selfie stick)\\b"
      ],
      "example": "Монопод трипод Xiaomi"
    },
    {
      "id": "pencil",
      "field": "item",
      "value": "STYLUS",
      "patterns": [
        "\\b(?:apple pencil|стилус)\\b"
      ],
      "example": "Apple Pencil Pro",
      "exclude": [
        "\\bнаконечник\\w*\\b"
      ]
    },
    {
      "id": "pencil_tips",
      "field": "item",
      "value": "STYLUS_TIPS",
      "patterns": [
        "\\b(?:наконечник\\w*|tips)\\b.*\\b(?:pencil|стилус)\\b"
      ],
      "example": "Наконечники для Apple Pencil"
    },
    {
      "id": "keyboard",
      "field": "item",
      "value": "KEYBOARD",
      "patterns": [
        "\\b(?:magic keyboard|клавиатур\\w*|keyboard)\\b"
      ],
      "example": "Magic Keyboard iPad",
      "exclude": [
        "^(?:гравировк\\w*|чистк\\w*|ремонт|замена)\\b"
      ]
    },
    {
      "id": "mouse",
      "field": "item",
      "value": "MOUSE",
      "patterns": [
        "\\b(?:magic mouse|мышь|mouse)\\b"
      ],
      "example": "Magic Mouse"
    },
    {
      "id": "power_bank",
      "field": "item",
      "value": "POWER_BANK",
      "patterns": [
        "\\b(?:power\\s*bank|powerbank|battery\\s+pack|пауэрбанк\\w*|повербанк\\w*|(?:внешн\\w*|портативн\\w*)\\s+(?:аккумулятор|батаре\\w*))\\b"
      ],
      "example": "Внешний аккумулятор Baseus"
    },
    {
      "id": "charging",
      "field": "item",
      "value": "CHARGER",
      "patterns": [
        "\\b(?:[cс]зу|азу|бзу|заряд\\w*|зар[.]?\\s*устройство|блок\\s+(?:питания|baseus)|power adapter|fast charger|wall charger|wireless charger)\\b"
      ],
      "example": "СЗУ Samsung 25W",
      "exclude": [
        "\\b(?:power\\s*bank|powerbank|battery\\s+pack|пауэрбанк\\w*|повербанк\\w*|(?:внешн\\w*|портативн\\w*)\\s+(?:аккумулятор|батаре\\w*))\\b",
        "\\b(?:dualsense|dual sense)\\b"
      ]
    },
    {
      "id": "charging_cable",
      "field": "item",
      "value": "CHARGER",
      "patterns": [
        "\\b(?:кабел\\w*|cable|провод)\\b"
      ],
      "example": "Кабель USB C",
      "exclude": [
        "\\b(?:power\\s*bank|powerbank|battery\\s+pack|пауэрбанк\\w*|повербанк\\w*|(?:внешн\\w*|портативн\\w*)\\s+(?:аккумулятор|батаре\\w*))\\b",
        "\\b(?:hdmi|aux|audio)\\b"
      ]
    },
    {
      "id": "bare_connector_cable",
      "field": "item",
      "value": "CHARGER",
      "patterns": [
        "^(?:usb\\s*c|type\\s*c)\\s*(?:to\\s+)?lightning\\b"
      ],
      "example": "USB C Lightning No Box"
    },
    {
      "id": "charging_bundle",
      "field": "item",
      "value": "CHARGER",
      "patterns": [
        "^комплект\\s+(?:baseus\\b.*\\b\\d{2,3}\\s*w\\b|vlp\\b.*\\bneo\\b)"
      ],
      "example": "Комплект VLP NEO 4in1",
      "scope": "livesklad-default",
      "review": "BUNDLE_POLICY"
    },
    {
      "id": "standing_charger",
      "field": "item",
      "value": "CHARGER",
      "patterns": [
        "^станция\\s+3\\s+в\\s+1\\s*\\(стоячая\\)$"
      ],
      "example": "Станция 3 в 1 (Стоячая)",
      "scope": "livesklad-default"
    },
    {
      "id": "connectivity",
      "field": "item",
      "value": "CONNECTIVITY",
      "patterns": [
        "\\b(?:hub|хаб|переходник|адаптер|евро\\s*переходник|aux|hdmi)\\b"
      ],
      "example": "Переходник USB C HDMI",
      "exclude": [
        "\\b(?:[cс]зу|азу|бзу|заряд\\w*|питания|power adapter)\\b",
        "\\b(?:power\\s*bank|powerbank|battery\\s+pack|пауэрбанк\\w*|повербанк\\w*|(?:внешн\\w*|портативн\\w*)\\s+(?:аккумулятор|батаре\\w*))\\b"
      ]
    },
    {
      "id": "packaging",
      "field": "item",
      "value": "PACKAGING",
      "patterns": [
        "\\b(?:фирменн\\w*\\s+пакет|упаковочн\\w*\\s+пакет)\\b"
      ],
      "example": "Фирменный пакет магазина"
    },
    {
      "id": "mixed_case_bundle",
      "field": "item",
      "value": "MIXED_BUNDLE",
      "patterns": [
        "\\b(?:комплект|набор)\\b.*(?:чехол\\s*\\+\\s*стекло|чехол\\s+и\\s+стекло)"
      ],
      "example": "Комплект чехол+стекло 13 Mini",
      "review": "BUNDLE_POLICY"
    },
    {
      "id": "screen_model_iphone",
      "field": "compatibility",
      "value": "IPHONE",
      "patterns": [
        "(?<!\\d)1[1-9]\\s*(?:pro(?:\\s*max)?|plus|mini|air|e)\\b"
      ],
      "example": "Чехол 17 Pro",
      "exclude": [
        "\\b(?:ipad|macbook|samsung|galaxy|самсунг|планшет|ноутбук)\\b"
      ],
      "review": "MODEL_ALIAS"
    },
    {
      "id": "screen_model_samsung",
      "field": "compatibility",
      "value": "SAMSUNG_PHONE",
      "patterns": [
        "\\b(?:s\\s*2[0-9](?:\\s*fe)?|[aа]\\s*(?:3[0-9]|5[0-9]))\\b"
      ],
      "example": "Стекло А35 S25FE",
      "exclude": [
        "\\b(?:ipad|iphone|айфон)\\b"
      ]
    },
    {
      "id": "camera_film_scope",
      "field": "compatibility",
      "value": "IPHONE",
      "patterns": [
        "\\bcamera film\\b"
      ],
      "example": "Camera Film",
      "scope": "livesklad-default",
      "review": "STORE_SPECIFIC_RULE"
    },
    {
      "id": "generic_samsung_target",
      "field": "compatibility",
      "value": "SAMSUNG_PHONE",
      "patterns": [
        "\\b(?:samsung|самсунг)\\b"
      ],
      "example": "Чехол Samsung",
      "exclude": [
        "\\b(?:watch|buds|tab|galaxy book)\\b"
      ]
    },
    {
      "id": "generic_watch_target",
      "field": "compatibility",
      "value": "APPLE_WATCH",
      "patterns": [
        "\\b(?:watch|iwatch)\\b",
        "\\b(?:38|41|42|45)\\s*(?:mm|мм)?\\s*[/ ]\\s*(?:41|45|49)(?:mm|мм)?\\b"
      ],
      "example": "Ремешок Watch Nike",
      "scope": "livesklad-default",
      "exclude": [
        "\\b(?:samsung|galaxy|garmin|huawei|xiaomi)\\b"
      ],
      "review": "TARGET_MODEL_REVIEW"
    },
    {
      "id": "generic_laptop_target",
      "field": "compatibility",
      "value": "LAPTOP_GENERIC",
      "patterns": [
        "\\b(?:ноутбук|ноутбука|ноутбуков|laptop|macbook)\\b"
      ],
      "example": "Чехол для ноутбука",
      "exclude": [
        "\\bmacbook\\b"
      ]
    },
    {
      "id": "service_repair",
      "field": "service",
      "value": "REPAIR",
      "patterns": [
        "\\b(?:ремонт|repair|замена|подклейк\\w*|восстановление платы|перепрошивк\\w*|прошивк\\w*)\\b"
      ],
      "example": "Замена дисплея"
    },
    {
      "id": "service_diagnostics",
      "field": "service",
      "value": "DIAGNOSTICS",
      "patterns": [
        "\\bдиагностик\\w*\\b"
      ],
      "example": "Диагностика устройства"
    },
    {
      "id": "service_cleaning",
      "field": "service",
      "value": "CLEANING",
      "patterns": [
        "\\b(?:чистк\\w*|чистка|очистк\\w*)\\b"
      ],
      "example": "Чистка устройства"
    },
    {
      "id": "service_setup",
      "field": "service",
      "value": "SETUP",
      "patterns": [
        "\\b(?:настройк\\w*|активац\\w*|установк\\w*|создание учетн\\w*|перенос\\s+(?:данных|контактов)|обновление программ\\w*|восстановление программ\\w*|сброс|восстановлен\\w*\\s+парол\\w*|перезагрузк\\w*|подзарядк\\w*|гравировк\\w*)\\b"
      ],
      "example": "Настройка устройства"
    },
    {
      "id": "office_setup",
      "field": "service",
      "value": "SETUP",
      "patterns": [
        "^(?:установка\\s+)?microsoft office$"
      ],
      "example": "Microsoft Office",
      "scope": "livesklad-default"
    },
    {
      "id": "warranty",
      "field": "commercial",
      "value": "WARRANTY_GENERIC",
      "patterns": [
        "^(?:(?:future store|моби\\s*сфера)\\s+)?(?:check(?:\\s*(?:discount|diskount))?(?:\\s*\\+)*|(?:elite|privilege)\\s+care)\\b"
      ],
      "example": "FUTURE STORE ELITE CARE",
      "exclude": [
        "\\bpremium\\b"
      ],
      "scope": "livesklad-default"
    },
    {
      "id": "protection",
      "field": "commercial",
      "value": "PREMIUM_PROTECTION",
      "patterns": [
        "^(?:(?:future store|моби\\s*сфера)\\s+)?(?:check\\s+premium|ultimate\\s+care)\\b"
      ],
      "example": "Моби Сфера Ultimate Care",
      "scope": "livesklad-default"
    },
    {
      "id": "used",
      "field": "condition",
      "value": "USED",
      "patterns": [
        "(?<!\\w)(?:б\\s*[/ ]\\s*у|used)(?!\\w)"
      ],
      "example": "iPhone Б/У"
    },
    {
      "id": "new",
      "field": "condition",
      "value": "NEW",
      "patterns": [
        "\\b(?:new|новый|новая|новое)\\b"
      ],
      "example": "iPad New"
    },
    {
      "id": "asis",
      "field": "condition",
      "value": "ASIS",
      "patterns": [
        "\\b(?:asis|as\\s+is)\\b"
      ],
      "example": "iPhone ASIS"
    },
    {
      "id": "repair_annotation",
      "field": "annotation",
      "value": "REPAIR_OR_DEFECT",
      "patterns": [
        "\\b(?:ремонт|repair|брак|дефект)\\b"
      ],
      "example": "iPhone Б/У ремонт"
    },
    {
      "id": "activated",
      "field": "annotation",
      "value": "ACTIVATED",
      "patterns": [
        "\\bактив\\b"
      ],
      "example": "iPhone АКТИВ",
      "exclude": [
        "\\bне\\s+актив\\b"
      ]
    },
    {
      "id": "not_activated",
      "field": "annotation",
      "value": "NOT_ACTIVATED",
      "patterns": [
        "\\bне\\s+актив\\b"
      ],
      "example": "iPhone НЕ АКТИВ"
    },
    {
      "id": "warranty_annotation",
      "field": "annotation",
      "value": "WARRANTY_NOTE",
      "patterns": [
